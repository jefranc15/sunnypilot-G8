[Unit]
Description=LG G8 donor vndservicemanager
Requires=g8-lg-tftp.service g8-lg-pd-mapper.service
After=g8-lg-tftp.service g8-lg-pd-mapper.service
Before=g8-lg-pm.service

[Service]
Type=simple
ExecStart=/usr/comma/g8-lg-vsm-run.sh
ExecStartPost=/bin/sleep 1
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
