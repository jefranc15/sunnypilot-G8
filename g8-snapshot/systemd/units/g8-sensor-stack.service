[Unit]
Description=LG G8 persistent Qualcomm SSC/SLPI sensor preparation
Requires=g8-init.service
Wants=g8-lg-qrtr.service
After=g8-init.service g8-lg-qrtr.service
Before=g8-sscrpcd.service g8-openpilot.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/data/g8-persistent/g8-sensor-stack-prepare.sh
StandardOutput=append:/data/g8-sensor-stack.log
StandardError=append:/data/g8-sensor-stack.log

[Install]
WantedBy=multi-user.target
