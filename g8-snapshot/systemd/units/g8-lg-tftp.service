[Unit]
Description=LG G8 donor Qualcomm TFTP server
DefaultDependencies=no
Requires=g8-lg-qrtr.service
After=g8-lg-qrtr.service
Before=rmt_storage.service init_sys_mss.service

[Service]
Type=simple
ExecStart=/usr/comma/g8-lg-tftp-run.sh
ExecStartPost=/usr/comma/g8-wait-tftp-ready.sh
Restart=on-failure
RestartSec=1

[Install]
WantedBy=sysinit.target
