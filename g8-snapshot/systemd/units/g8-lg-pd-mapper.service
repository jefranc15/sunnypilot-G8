[Unit]
Description=LG G8 donor service-registry pd-mapper
DefaultDependencies=no
Requires=g8-lg-qrtr.service
After=g8-lg-qrtr.service
Before=network-pre.target NetworkManager.service cnss-daemon.service

[Service]
Type=simple
ExecStart=/usr/comma/g8-lg-pd-run.sh
Restart=always
RestartSec=1

[Install]
WantedBy=sysinit.target
