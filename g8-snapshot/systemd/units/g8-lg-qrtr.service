[Unit]
Description=LG G8 donor QRTR nameserver
DefaultDependencies=no
Requires=g8-init.service
After=g8-init.service
Before=g8-lg-pd-mapper.service network-pre.target NetworkManager.service cnss-daemon.service

[Service]
Type=simple
ExecStartPre=/usr/comma/g8-lg-wlan-prepare.sh
ExecStart=/usr/comma/g8-lg-qrtr-run.sh
Restart=always
RestartSec=1

[Install]
WantedBy=sysinit.target
