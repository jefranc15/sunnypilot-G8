[Unit]
Description=LG G8 donor CNSS daemon
Requires=g8-lg-pm-proxy.service
After=g8-lg-pm-proxy.service
Before=g8-lg-qcwlan-on.service network-pre.target NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/comma/g8-lg-cnss-run.sh
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
